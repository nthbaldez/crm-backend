{
  "moduleFileExtensions": ["js", "json", "ts"],
  
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  
  "transform": {
    "^.+\\.(t)s$": [
      "ts-jest"
    ]
  },
  "setupFilesAfterEnv": ["<rootDir>/test/setup-e2e.ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^generated/prisma/client(.*)$": "<rootDir>/generated/prisma/client$1"
  },
  "resetMocks": true
}
